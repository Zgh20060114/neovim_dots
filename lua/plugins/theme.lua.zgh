-- return {
--   {
--     "ellisonleao/gruvbox.nvim",
--     priority = 1000,
--     -- config = true,
--     config = function()
--       require("gruvbox").setup({ contrast = "hard", transparent = true })
--       vim.cmd.colorscheme("gruvbox")
--     end,
--     opts = ...,
--   },
-- }

return {
  {
    "ellisonleao/gruvbox.nvim",
    priority = 1000,
    config = function()
      require("gruvbox").setup({
        contrast = "hard",
        transparent_mode = true, -- 开启透明模式
      })
      vim.cmd.colorscheme("gruvbox")
    end,
  },
}

